{
  "name": "tsmcp-lsp",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript MCP Language Server Protocol Bridge",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "tsc",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n.mjs src/locales en",
    "check:unused": "knip",
    "clean": "rimraf dist coverage .scratch \"**/*.tsbuildinfo\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "typescript": "^5.0.0",
    "typescript-language-server": "^4.0.0",
    "vscode-languageserver-protocol": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript-eslint": "^8.73.0",
    "vitest": "^1.0.0"
  }
}
